<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/player_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black">

    <!-- Full-screen immersive album artwork -->
    <ImageView
        android:id="@+id/iv_background"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="centerCrop" />

    <!-- Subtle vertical scrim so text/controls stay legible -->
    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_scrim_art" />

    <!-- Swipeable pages (tap / long-press handling, transparent) -->
    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/vp_songs"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Floating top bar (aligned safely below the status bar via insets) -->
    <LinearLayout
        android:id="@+id/top_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:background="@drawable/bg_scrim_top"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="12dp"
        android:paddingBottom="12dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tv_now_playing"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/now_playing"
                android:textColor="#E6FFFFFF"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_playing_position"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#B3FFFFFF"
                android:textSize="12sp" />
        </LinearLayout>

        <FrameLayout
            android:id="@+id/btn_sleep"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginEnd="12dp"
            android:background="@drawable/bg_round_icon">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_timer"
                android:tint="#FFFFFF" />

            <TextView
                android:id="@+id/tv_sleep_badge"
                android:layout_width="12dp"
                android:layout_height="12dp"
                android:layout_gravity="end|bottom"
                android:background="@drawable/bg_seek_thumb"
                android:gravity="center"
                android:textColor="@color/white"
                android:textSize="7sp"
                android:visibility="gone" />
        </FrameLayout>

        <FrameLayout
            android:id="@+id/btn_lyrics"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginEnd="12dp"
            android:background="@drawable/bg_round_icon">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_music_note"
                android:tint="#FFFFFF" />
        </FrameLayout>

        <FrameLayout
            android:id="@+id/btn_queue"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_round_icon">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_queue"
                android:tint="#FFFFFF" />
        </FrameLayout>
    </LinearLayout>

    <!-- Speed chip -->
    <TextView
        android:id="@+id/tv_speed_chip"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="84dp"
        android:background="@drawable/bg_glass_chip"
        android:paddingHorizontal="14dp"
        android:paddingVertical="6dp"
        android:text="@string/speed_2x"
        android:textColor="#FFFFFF"
        android:textSize="12sp"
        android:textStyle="bold"
        android:visibility="gone" />

    <!-- Offline badge -->
    <TextView
        android:id="@+id/tv_offline_badge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="124dp"
        android:background="@drawable/bg_glass_chip"
        android:paddingHorizontal="14dp"
        android:paddingVertical="6dp"
        android:text="@string/offline_playback"
        android:textColor="#FFFFFF"
        android:textSize="11sp"
        android:visibility="gone" />

    <!-- Floating side controls (Like / Download / More) -->
    <LinearLayout
        android:id="@+id/side_toolbar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_vertical|end"
        android:layout_marginEnd="16dp"
        android:orientation="vertical">

        <FrameLayout
            android:id="@+id/btn_like"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:layout_marginBottom="18dp"
            android:background="@drawable/bg_round_icon">

            <ImageView
                android:id="@+id/iv_like"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_favorite_border"
                android:tint="#FFFFFF" />
        </FrameLayout>

        <FrameLayout
            android:id="@+id/btn_download"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:layout_marginBottom="18dp"
            android:background="@drawable/bg_round_icon">

            <ImageView
                android:id="@+id/iv_download"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_download"
                android:tint="#FFFFFF" />

            <ProgressBar
                android:id="@+id/pb_download"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_gravity="center"
                android:indeterminateTint="#FFFFFF"
                android:progressTint="#FFFFFF"
                android:visibility="gone" />
        </FrameLayout>

        <FrameLayout
            android:id="@+id/btn_more"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:background="@drawable/bg_round_icon">

            <ImageView
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_more_vert"
                android:tint="#FFFFFF" />
        </FrameLayout>
    </LinearLayout>

    <!-- Floating bottom player bar with dark gradient shadow -->
    <FrameLayout
        android:id="@+id/bottom_panel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@drawable/bg_scrim_bottom_ext">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:paddingTop="18dp"
            android:paddingBottom="14dp">

            <TextView
                android:id="@+id/tv_song_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:gravity="center"
                android:maxLines="2"
                android:textColor="#FFFFFF"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_song_artist"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:ellipsize="end"
                android:gravity="center"
                android:maxLines="1"
                android:textColor="#B3FFFFFF"
                android:textSize="14sp" />

            <androidx.appcompat.widget.AppCompatSeekBar
                android:id="@+id/sb_progress"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:max="1000"
                android:progressDrawable="@drawable/bg_seekbar"
                android:thumb="@drawable/bg_seek_thumb"
                android:thumbTint="@color/white" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tv_current"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="0:00"
                    android:textColor="#CCFFFFFF"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/tv_duration"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0:00"
                    android:textColor="#CCFFFFFF"
                    android:textSize="12sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:gravity="center"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/btn_prev"
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:padding="16dp"
                    android:src="@drawable/ic_skip_prev"
                    android:tint="#FFFFFF" />

                <ImageView
                    android:id="@+id/btn_play"
                    android:layout_width="66dp"
                    android:layout_height="66dp"
                    android:layout_marginHorizontal="22dp"
                    android:background="@drawable/bg_btn_neon"
                    android:padding="21dp"
                    android:src="@drawable/ic_play"
                    android:tint="@color/text_on_accent" />

                <ImageView
                    android:id="@+id/btn_next"
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:padding="16dp"
                    android:src="@drawable/ic_skip_next"
                    android:tint="#FFFFFF" />
            </LinearLayout>

            <!-- Shuffle & Repeat segmented pill toggle -->
            <LinearLayout
                android:id="@+id/group_play_modes"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_glass_chip"
                android:orientation="horizontal"
                android:padding="2dp">

                <FrameLayout
                    android:id="@+id/btn_shuffle"
                    android:layout_width="44dp"
                    android:layout_height="match_parent"
                    android:background="@drawable/bg_pill_segment_start"
                    android:clickable="true"
                    android:focusable="true">

                    <ImageView
                        android:id="@+id/iv_shuffle"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_shuffle"
                        android:tint="#B3FFFFFF" />
                </FrameLayout>

                <FrameLayout
                    android:id="@+id/btn_repeat"
                    android:layout_width="44dp"
                    android:layout_height="match_parent"
                    android:background="@drawable/bg_pill_segment_end"
                    android:clickable="true"
                    android:focusable="true">

                    <ImageView
                        android:id="@+id/iv_repeat"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_repeat"
                        android:tint="#B3FFFFFF" />

                    <TextView
                        android:id="@+id/tv_repeat_badge"
                        android:layout_width="14dp"
                        android:layout_height="14dp"
                        android:layout_gravity="top|end"
                        android:layout_marginEnd="1dp"
                        android:layout_marginTop="1dp"
                        android:background="@drawable/bg_seek_thumb"
                        android:gravity="center"
                        android:text="1"
                        android:textColor="@color/text_on_accent"
                        android:textSize="9sp"
                        android:textStyle="bold"
                        android:visibility="gone" />
                </FrameLayout>
            </LinearLayout>

            <!-- Playback signature chip (cycles Normal / Slowed / Nightcore) -->
            <TextView
                android:id="@+id/btn_audio_mode"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_glass_chip"
                android:paddingHorizontal="18dp"
                android:paddingVertical="6dp"
                android:text="1x"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>
    </FrameLayout>
</FrameLayout>