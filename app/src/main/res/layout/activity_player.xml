<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/player_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black">

    <!-- Full-screen immersive album artwork — 100% brightness by default -->
    <ImageView
        android:id="@+id/iv_background"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="centerCrop" />

    <!-- Lyrics-only dim layer — fully transparent by default; fades to a
         60% translucent scrim ONLY while the karaoke/lyrics view is open.
         Never tints the artwork otherwise. -->
    <View
        android:id="@+id/art_tint"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0"
        android:importantForAccessibility="no" />

    <!-- Subtle dark gradient covering only the bottom ~25% of the screen:
         keeps white text + controls readable without dimming the artwork. -->
    <View
        android:id="@+id/iv_bottom_gradient"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_player_bottom_gradient"
        android:importantForAccessibility="no" />

    <!-- Swipeable pages (tap / long-press handling, transparent) -->
    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/vp_songs"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Centered play/pause tap indicator: flashed on every pager tap.
         Non-clickable so taps pass straight through to the pager below. -->
    <ImageView
        android:id="@+id/iv_play_pause_indicator"
        android:layout_width="96dp"
        android:layout_height="96dp"
        android:layout_gravity="center"
        android:background="@drawable/bg_glass_circle"
        android:clickable="false"
        android:contentDescription="@null"
        android:focusable="false"
        android:importantForAccessibility="no"
        android:padding="26dp"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_pause"
        android:tint="#FFFFFF"
        android:visibility="gone" />

    <!-- Floating top bar (aligned safely below the status bar via insets) -->
    <LinearLayout
        android:id="@+id/top_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:background="@drawable/bg_scrim_top"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="12dp"
        android:paddingBottom="12dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tv_now_playing"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/now_playing"
                android:textColor="#E6FFFFFF"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_playing_position"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#B3FFFFFF"
                android:textSize="12sp" />
        </LinearLayout>

        <FrameLayout
            android:id="@+id/btn_sleep"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginEnd="12dp"
            android:background="@drawable/bg_glass_circle">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_timer"
                android:tint="#FFFFFF" />

            <TextView
                android:id="@+id/tv_sleep_badge"
                android:layout_width="12dp"
                android:layout_height="12dp"
                android:layout_gravity="end|bottom"
                android:background="@drawable/bg_seek_thumb"
                android:gravity="center"
                android:textColor="@color/white"
                android:textSize="7sp"
                android:visibility="gone" />
        </FrameLayout>

        <FrameLayout
            android:id="@+id/btn_lyrics"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginEnd="12dp"
            android:background="@drawable/bg_glass_circle">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_music_note"
                android:tint="#FFFFFF" />
        </FrameLayout>

        <FrameLayout
            android:id="@+id/btn_queue"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_glass_circle">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_queue"
                android:tint="#FFFFFF" />
        </FrameLayout>
    </LinearLayout>

    <!-- Speed chip (visible while long-press 2x speed is held) -->
    <TextView
        android:id="@+id/tv_speed_chip"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="84dp"
        android:background="@drawable/bg_glass_chip"
        android:paddingHorizontal="14dp"
        android:paddingVertical="6dp"
        android:text="@string/speed_2x"
        android:textColor="#FFFFFF"
        android:textSize="12sp"
        android:textStyle="bold"
        android:visibility="gone" />

    <!-- Offline badge -->
    <TextView
        android:id="@+id/tv_offline_badge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="124dp"
        android:background="@drawable/bg_glass_chip"
        android:paddingHorizontal="14dp"
        android:paddingVertical="6dp"
        android:text="@string/offline_playback"
        android:textColor="#FFFFFF"
        android:textSize="11sp"
        android:visibility="gone" />

    <!-- Bottom HUD: artist profile (clickable) + playback timers -->
    <LinearLayout
        android:id="@+id/player_hud"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_marginBottom="32dp"
        android:background="@drawable/bg_player_hud"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="8dp">

            <!-- Reels-style clickable artist profile & song details -->
            <LinearLayout
                android:id="@+id/btn_artist"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingTop="2dp"
                android:paddingBottom="2dp">

                <ImageView
                    android:id="@+id/iv_artist_avatar"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:background="@drawable/bg_round_art"
                    android:clipToOutline="true"
                    android:scaleType="centerCrop" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tv_song_title"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:shadowColor="#66000000"
                        android:shadowDy="1"
                        android:shadowRadius="4"
                        android:textColor="#FFFFFF"
                        android:textSize="17sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tv_song_artist"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:shadowColor="#66000000"
                        android:shadowDy="1"
                        android:shadowRadius="4"
                        android:textColor="#EBFFFFFF"
                        android:textSize="13sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- Floating playback timers, left-anchored and kept clear of the
                 right action rail (no more overlap under the 3-dots button) -->
            <LinearLayout
                android:id="@+id/timers_row"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tv_current_time"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="00:00"
                    android:shadowColor="#66000000"
                    android:shadowDy="1"
                    android:shadowRadius="3"
                    android:textColor="#F2FFFFFF"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_total_time"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="00:00"
                    android:shadowColor="#66000000"
                    android:shadowDy="1"
                    android:shadowRadius="3"
                    android:textColor="#CCFFFFFF"
                    android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- Bottom-right vertical action rail: Like / Download / Shuffle / Repeat / More.
         Floats strictly ABOVE the HUD + bottom gradient (HUD sits ~109dp from the
         screen bottom), so no button ever overlaps the dark bar. -->
    <LinearLayout
        android:id="@+id/side_toolbar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="112dp"
        android:orientation="vertical">

        <FrameLayout
            android:id="@+id/btn_like"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:layout_marginBottom="16dp"
            android:background="@drawable/bg_glass_circle">

            <ImageView
                android:id="@+id/iv_like"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_favorite_border"
                android:tint="#FFFFFF" />
        </FrameLayout>

        <FrameLayout
            android:id="@+id/btn_download"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:layout_marginBottom="16dp"
            android:background="@drawable/bg_glass_circle">

            <ImageView
                android:id="@+id/iv_download"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_download"
                android:tint="#FFFFFF" />

            <ProgressBar
                android:id="@+id/pb_download"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_gravity="center"
                android:indeterminateTint="#FFFFFF"
                android:progressTint="#FFFFFF"
                android:visibility="gone" />
        </FrameLayout>

        <!-- Shuffle toggle (accent-filled circle while active) -->
        <FrameLayout
            android:id="@+id/btn_shuffle"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:layout_marginBottom="16dp"
            android:background="@drawable/bg_glass_circle"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:id="@+id/iv_shuffle"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_shuffle"
                android:tint="#FFFFFF" />
        </FrameLayout>

        <!-- Repeat toggle (accent-filled circle while active, "1" badge for one) -->
        <FrameLayout
            android:id="@+id/btn_repeat"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:layout_marginBottom="16dp"
            android:background="@drawable/bg_glass_circle"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:id="@+id/iv_repeat"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_repeat"
                android:tint="#FFFFFF" />

            <TextView
                android:id="@+id/tv_repeat_badge"
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:layout_gravity="top|end"
                android:layout_marginEnd="2dp"
                android:layout_marginTop="2dp"
                android:background="@drawable/bg_seek_thumb"
                android:gravity="center"
                android:text="1"
                android:textColor="@color/text_on_accent"
                android:textSize="9sp"
                android:textStyle="bold"
                android:visibility="gone" />
        </FrameLayout>

        <FrameLayout
            android:id="@+id/btn_more"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:background="@drawable/bg_glass_circle">

            <ImageView
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_more_vert"
                android:tint="#FFFFFF" />
        </FrameLayout>
    </LinearLayout>

    <!-- Reels-style draggable ultra-thin progress pinned at the very bottom
         edge, below the HUD/gradient: 3dp resting, auto-thickens to 6dp
         while scrubbing for a comfy touch target; accent clip + constant
         light track. Seeking never pauses playback. -->
    <SeekBar
        android:id="@+id/sb_progress"
        android:layout_width="match_parent"
        android:layout_height="3dp"
        android:layout_gravity="bottom"
        android:layout_marginBottom="3dp"
        android:max="1000"
        android:progress="0"
        android:progressDrawable="@drawable/bg_seek_player"
        android:splitTrack="false"
        android:thumb="@drawable/bg_seek_player_thumb"
        android:thumbTint="@color/accent" />

    <!-- Buffering pulse: subtle indeterminate shimmer across the bottom line
         while audio data is downloading (STATE_BUFFERING). -->
    <ProgressBar
        android:id="@+id/pb_buffering"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="3dp"
        android:layout_gravity="bottom"
        android:layout_marginBottom="3dp"
        android:importantForAccessibility="no"
        android:indeterminate="true"
        android:indeterminateTint="#59FFFFFF"
        android:maxHeight="3dp"
        android:minHeight="3dp"
        android:progressBackgroundTint="#00FFFFFF"
        android:visibility="gone" />

    <!-- YouTube-style double-tap skip chips: flash on the tapped side -->
    <TextView
        android:id="@+id/tv_skip_back"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="start|center_vertical"
        android:layout_marginStart="36dp"
        android:alpha="0"
        android:background="@drawable/bg_glass_chip"
        android:importantForAccessibility="no"
        android:paddingHorizontal="16dp"
        android:paddingVertical="10dp"
        android:text="@string/skip_back_10"
        android:textColor="#FFFFFF"
        android:textSize="14sp"
        android:textStyle="bold"
        android:visibility="gone" />

    <TextView
        android:id="@+id/tv_skip_forward"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end|center_vertical"
        android:layout_marginEnd="36dp"
        android:alpha="0"
        android:background="@drawable/bg_glass_chip"
        android:importantForAccessibility="no"
        android:paddingHorizontal="16dp"
        android:paddingVertical="10dp"
        android:text="@string/skip_forward_10"
        android:textColor="#FFFFFF"
        android:textSize="14sp"
        android:textStyle="bold"
        android:visibility="gone" />

    <!-- Host for overlay pages (artist profile) opened from the player -->
    <FrameLayout
        android:id="@+id/overlay_host"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no" />
</FrameLayout>