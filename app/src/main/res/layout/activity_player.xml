<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/player_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black">

    <!-- Dim backdrop behind the reels pager: shows through while the
         outgoing/incoming artwork pages slide and scale. -->
    <ImageView
        android:id="@+id/iv_background"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0.35"
        android:importantForAccessibility="no"
        android:scaleType="centerCrop" />

    <!-- Swipeable artwork pages — each page owns its own full-screen artwork
         so the next/previous song visibly slides in with the finger. -->
    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/vp_songs"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Lyrics-only dim layer — fully transparent by default; fades to a
         60% translucent scrim ONLY while the karaoke/lyrics view is open.
         Sits ABOVE the pager so it dims every artwork page. -->
    <View
        android:id="@+id/art_tint"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0"
        android:importantForAccessibility="no" />

    <!-- Centered play/pause tap indicator: flashed on every pager tap.
         Non-clickable so taps pass straight through to the pager below. -->
    <ImageView
        android:id="@+id/iv_play_pause_indicator"
        android:layout_width="96dp"
        android:layout_height="96dp"
        android:layout_gravity="center"
        android:background="@drawable/bg_glass_circle"
        android:clickable="false"
        android:contentDescription="@null"
        android:focusable="false"
        android:importantForAccessibility="no"
        android:padding="26dp"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_pause"
        android:tint="#FFFFFF"
        android:visibility="gone" />

    <!-- Floating top bar (aligned safely below the status bar via insets) -->
    <LinearLayout
        android:id="@+id/top_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:background="@drawable/bg_scrim_top"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="12dp"
        android:paddingBottom="12dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tv_now_playing"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/now_playing"
                android:textColor="#E6FFFFFF"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_playing_position"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#B3FFFFFF"
                android:textSize="12sp" />
        </LinearLayout>

        <FrameLayout
            android:id="@+id/btn_sleep"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginEnd="12dp"
            android:background="@drawable/bg_glass_circle">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_timer"
                android:tint="#FFFFFF" />

            <TextView
                android:id="@+id/tv_sleep_badge"
                android:layout_width="12dp"
                android:layout_height="12dp"
                android:layout_gravity="end|bottom"
                android:background="@drawable/bg_seek_thumb"
                android:gravity="center"
                android:textColor="@color/white"
                android:textSize="7sp"
                android:visibility="gone" />
        </FrameLayout>

        <FrameLayout
            android:id="@+id/btn_lyrics"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginEnd="12dp"
            android:background="@drawable/bg_glass_circle">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_music_note"
                android:tint="#FFFFFF" />
        </FrameLayout>

        <FrameLayout
            android:id="@+id/btn_spatial"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginEnd="12dp"
            android:background="@drawable/bg_glass_circle">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_equalizer"
                android:tint="#FFFFFF" />
        </FrameLayout>

        <FrameLayout
            android:id="@+id/btn_queue"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_glass_circle">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_queue"
                android:tint="#FFFFFF" />
        </FrameLayout>
    </LinearLayout>

    <!-- Speed chip (visible while long-press 2x speed is held) -->
    <TextView
        android:id="@+id/tv_speed_chip"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="84dp"
        android:background="@drawable/bg_glass_chip"
        android:paddingHorizontal="14dp"
        android:paddingVertical="6dp"
        android:text="@string/speed_2x"
        android:textColor="#FFFFFF"
        android:textSize="12sp"
        android:textStyle="bold"
        android:visibility="gone" />

    <!-- Offline badge -->
    <TextView
        android:id="@+id/tv_offline_badge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="124dp"
        android:background="@drawable/bg_glass_chip"
        android:paddingHorizontal="14dp"
        android:paddingVertical="6dp"
        android:text="@string/offline_playback"
        android:textColor="#FFFFFF"
        android:textSize="11sp"
        android:visibility="gone" />

    <!-- Reels-style draggable ultra-thin progress pinned at the very bottom
         edge: 3dp resting, auto-thickens to 6dp while scrubbing for a comfy
         touch target; accent clip + constant light track. Seeking never
         pauses playback. -->
    <SeekBar
        android:id="@+id/sb_progress"
        android:layout_width="match_parent"
        android:layout_height="3dp"
        android:layout_gravity="bottom"
        android:layout_marginBottom="3dp"
        android:max="1000"
        android:progress="0"
        android:progressDrawable="@drawable/bg_seek_player"
        android:splitTrack="false"
        android:thumb="@drawable/bg_seek_player_thumb"
        android:thumbTint="@color/accent" />

    <!-- YouTube-style double-tap skip chips: flash on the tapped side -->
    <TextView
        android:id="@+id/tv_skip_back"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="start|center_vertical"
        android:layout_marginStart="36dp"
        android:alpha="0"
        android:background="@drawable/bg_glass_chip"
        android:importantForAccessibility="no"
        android:paddingHorizontal="16dp"
        android:paddingVertical="10dp"
        android:text="@string/skip_back_10"
        android:textColor="#FFFFFF"
        android:textSize="14sp"
        android:textStyle="bold"
        android:visibility="gone" />

    <TextView
        android:id="@+id/tv_skip_forward"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end|center_vertical"
        android:layout_marginEnd="36dp"
        android:alpha="0"
        android:background="@drawable/bg_glass_chip"
        android:importantForAccessibility="no"
        android:paddingHorizontal="16dp"
        android:paddingVertical="10dp"
        android:text="@string/skip_forward_10"
        android:textColor="#FFFFFF"
        android:textSize="14sp"
        android:textStyle="bold"
        android:visibility="gone" />

    <!-- Host for overlay pages (artist profile) opened from the player -->
    <FrameLayout
        android:id="@+id/overlay_host"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no" />
</FrameLayout>